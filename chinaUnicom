[Argument]

chinaUnicomCookie = input,"",tag=Cookie,desc=Token#AppId (多账号用 & 分隔)

cookieCapture = switch,true,tag=自动获取 Cookie,desc=登录联通 App 时自动保存 Token

cron = input,"0 7,20 * * *",tag=每日任务时间,

grabCron = input,"58 9,17 * * *",tag=抢兑时间,

grabMode = switch,false,tag=抢兑开关,desc=开启后按抢兑时间执行抢话费券

[Script]

http-response ^https:\/\/m\.client\.10010\.com\/mobileService\/onLine\.htm script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js, requires-body=true, tag=联通Cookie捕获, enable={cookieCapture}

cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js, timeout=600, tag=中国联通, argument=grabMode={grabMode}

cron {grabCron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js, timeout=600, tag=中国联通-抢兑, argument=grab_mode=true

