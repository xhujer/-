[Argument]
cron = input,"0 7,20 * * *",tag=定时执行,desc=每天07:00和20:00执行
queryOnly = switch,false,tag=仅查询模式,desc=只查询资产和任务状态，不执行任务

capture = switch,true,tag=自动抓取账号,desc=退出并重新登录中国联通 App 后自动保存；多账号自动追加

enableSign = switch,true,tag=首页签到,desc=签到、月签、任务、话费红包
enableLtzf = switch,true,tag=联通祝福,desc=任务及抽奖
enableTtxc = switch,true,tag=通通乡村,desc=签到、游戏任务、农场充能
enableMarket = switch,true,tag=权益超市,desc=任务、抽奖和记录（会员中心已下线）
enableSecurity = switch,true,tag=安全管家,desc=签到、日常任务和积分领取
enableCloud = switch,true,tag=联通云盘,desc=海岛逐浪应援(AI入戏/打卡/抽奖)、会员体验和重复文件清理
enableWoread = switch,false,tag=联通阅读,desc=阅读、心跳和抽奖；耗时较长，默认关闭
enableAiting = switch,true,tag=联通爱听,desc=签到、积分任务和阅读时长
enableWostore = switch,true,tag=沃云手机,desc=签到、任务、抽奖和积分
enableRegional = switch,true,tag=区域专区,desc=新疆、河南、云南、辽宁和安徽

marketTask = switch,true,tag=权益超市任务,desc=执行浏览和分享任务
marketDraw = switch,true,tag=权益超市抽奖,desc=自动使用已有抽奖次数
marketClaim = switch,true,tag=权益自动领奖,desc=查询可领取记录
hometownEnable = switch,false,tag=云盘家乡打卡,desc=归属地识别+上传+抽奖+自动清理；活动可能已下线，默认关闭
wostoreMaxDraw = input,"1",tag=沃云积分抽奖上限,desc=默认 1 次
grabCoupon = switch,false,tag=日常任务同时抢券,desc=高频操作，默认关闭；建议使用独立抢兑定时
grabAmount = input,"5",tag=话费券面额,desc=匹配包含指定面额的奖品
ahAmount = input,"",tag=安徽红包面额,desc=例如 50；留空则不执行（周五 10 点开抢）
requestNode = input,"",tag=请求策略或节点,desc=留空按当前分流
provinceOverride = select,"","安徽","浙江","新疆","河南","云南","辽宁",tag=号码归属地,desc=默认自动识别；识别失败时手动选择
zjDecodeData = input,"",tag=浙江能量站票据,desc=浙江号码签到用；微信打开浙江联通能量站页面，把网址里 decodeData= 后面那串粘进来
zjToken = input,"",tag=浙江任务Token,desc=做任务用（可选）；抓包 mini.zj186.com 请求里的 access_token
zjOpenId = input,"",tag=浙江open_id,desc=做任务用（可选）；同上的 open_id
cloudImageFid = input,"",tag=云盘人脸图片 FID,desc=AI入戏指定图片，留空则自动从云盘挑选

[Script]
http-request ^https:\/\/(?:m\.client\.10010\.com\/mobileService\/(?:onLine|login|v1\/login)\.htm|(?:loginxx|loginhl)\.10010\.com\/mobileService\/(?:onLine|login_vcode_member)\.htm) script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,requires-body=true,timeout=30,tag=🔵中国联通抓取账号,enable={capture}

cron {cron} script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通自动任务,argument=[{queryOnly},{enableSign},{enableLtzf},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{marketTask},{marketDraw},{marketClaim},{hometownEnable},{wostoreMaxDraw},{grabCoupon},{grabAmount},{ahAmount},{requestNode},{provinceOverride},{cloudImageFid},{zjDecodeData},{zjToken},{zjOpenId}]

cron 58 9,17 * * * script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=600,tag=🔴中国联通抢兑,argument=[{grabAmount},{requestNode}]

cron 58 9 * * 5 script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=600,tag=🟠安徽超级星期五,argument=[{provinceOverride},{ahAmount},{requestNode}]


