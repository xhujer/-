[Argument]
cron = input,"0 7,20 * * *",tag=定时执行,desc=默认每天07:00和20:00执行
capture = switch,true,tag=自动抓取账号,desc=每次退出重登联通App时自动保存token(默认开启)
mode = select,"all","sign","ltzf","ttlxj","ttxc","market","security","cloud","woread","aiting","wostore","regional",tag=执行模块,desc=all为顺序执行全部已开启模块
queryOnly = switch,false,tag=仅查询模式,desc=只查询资产和任务状态，不提交任务
enableSign = switch,true,tag=首页签到,desc=签到、月签、任务、红包
enableLtzf = switch,true,tag=联通祝福,desc=任务及抽奖
enableTtlxj = switch,true,tag=天天领现金,desc=每日打卡和立减金
enableTtxc = switch,true,tag=通通乡村,desc=签到、游戏任务、充能
enableMarket = switch,true,tag=权益超市,desc=浇水、任务、会员中心、抽奖
enableSecurity = switch,true,tag=安全管家,desc=签到、日常任务和积分领取
enableCloud = switch,true,tag=联通云盘,desc=乘风活动、会员体验
enableWoread = switch,false,tag=联通阅读,desc=阅读红包、心跳和抽奖；默认关闭
enableAiting = switch,true,tag=联通爱听,desc=签到、积分任务和积分查询
enableWostore = switch,true,tag=沃云手机,desc=签到、任务、抽奖、积分
enableRegional = switch,true,tag=区域专区,desc=新疆、河南、云南、辽宁和安徽
enableNotify = switch,true,tag=结果通知,desc=运行结束后汇总通知
marketWater = switch,true,tag=权益超市浇水,desc=执行每日浇水
marketTask = switch,true,tag=权益超市任务,desc=执行浏览和分享任务
marketMember = switch,true,tag=权益会员中心,desc=执行会员中心浏览积分任务
marketDraw = switch,true,tag=权益超市抽奖,desc=自动使用已有抽奖次数
marketClaim = switch,true,tag=权益自动领奖,desc=查询并处理可领取记录
grabCoupon = switch,false,tag=抢话费券,desc=高频操作，默认关闭
grabAmount = input,"5",tag=话费券面额,desc=匹配含指定面额的奖品
ahFriday = switch,false,tag=安徽超级星期五,desc=仅安徽号码、周五执行
ahAmount = input,"",tag=安徽红包面额,desc=例如50；留空不执行
requestNode = input,"",tag=请求策略或节点,desc=留空按当前分流
cloudImageFid = input,"",tag=云盘人脸图片FID,desc=乘风模板图片
cloudUploadName = input,"8648",tag=云盘上传文件名,desc=清理指定系列文件
ttxcGarbageWait = input,"28",tag=垃圾分类等待秒数,desc=默认28秒
ttxcGrowMax = input,"20",tag=单地块最大充能,desc=默认20次
wostoreMaxDraw = input,"1",tag=沃云积分抽奖上限,desc=默认1次

[Script]
# 增强抓包规则：覆盖多个已知登录/心跳路径（原版仅 onLine.htm）
http-request ^https:\/\/(m\.client\.10010\.com\/(mobileService\/(onLine|login|v1\/login)\.htm|edop_ng\/getTicketByNative)|wocare\.unisk\.cn\/mbh\/getToken) script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,requires-body=true,timeout=30,tag=🔵中国联通抓取账号,enable={capture}
# 定时任务
cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通自动任务,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{enableNotify},{marketWater},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]
# 手动一键触发
generic script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通手动执行,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{enableNotify},{marketWater},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]

