[Argument]
cron = input,"0 7,20 * * *",tag=执行时间,desc=每天07:00和20:00执行
capture = switch,true,tag=自动获取账号,desc=退出重登联通App时自动保存token
mode = select,"all","sign","ltzf","ttlxj","ttxc","market","security","cloud","woread","aiting","wostore","regional",tag=执行模块,desc=all为顺序执行全部
queryOnly = switch,false,tag=仅查询模式
enableSign = switch,true,tag=首页签到
enableLtzf = switch,true,tag=联通祝福
enableTtlxj = switch,true,tag=天天领现金
enableTtxc = switch,true,tag=通通乡村
enableMarket = switch,true,tag=权益超市
enableSecurity = switch,true,tag=安全管家
enableCloud = switch,true,tag=联通云盘
enableWoread = switch,false,tag=联通阅读
enableAiting = switch,true,tag=联通爱听
enableWostore = switch,true,tag=沃云手机
enableRegional = switch,true,tag=区域专区
enableNotify = switch,true,tag=结果通知
marketWater = switch,true,tag=权益超市浇水
marketTask = switch,true,tag=权益超市任务
marketMember = switch,true,tag=权益会员中心
marketDraw = switch,true,tag=权益超市抽奖
marketClaim = switch,true,tag=权益自动领奖
grabCoupon = switch,false,tag=抢话费券
grabAmount = input,"5",tag=话费券面额
ahFriday = switch,false,tag=安徽超级星期五
ahAmount = input,"",tag=安徽红包面额
requestNode = input,"",tag=请求策略
cloudImageFid = input,"",tag=云盘人脸FID
cloudUploadName = input,"8648",tag=云盘上传文件名
ttxcGarbageWait = input,"28",tag=垃圾分类等待秒数
ttxcGrowMax = input,"20",tag=单地块最大充能
wostoreMaxDraw = input,"1",tag=沃云积分抽奖上限

[Script]
# 抓包：本地补丁脚本（处理Base64 body + loginxx域名），token存入原版cu_accounts_v2
http-request ^https:\/\/(login[a-z0-9]*)\.10010\.com\/(mobileService\/onLine\.htm|login-web\/v1\/bindlist\/isbinded) script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom_capture_patch.js,requires-body=true,binary-body-mode=true,timeout=30,tag=🔵中国联通获取账号,enable={capture}
# 定时任务：远程原版脚本（不变）
cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通自动任务,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{enableNotify},{marketWater},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]
# 手动执行：远程原版脚本（不变）
generic script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通手动执行,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{enableNotify},{marketWater},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]

