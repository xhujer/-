#!name=中国联通
#!desc=签到/浇水/任务/抽奖 | token写入后每天自动执行
#!date=2026-08-07
#!system=iOS,iPadOS
#!loon_version=3.2.4(787)
#!tag=中国联通,签到

[Argument]
cron_time = input,"0 7,20 * * *",tag=定时执行,desc=每天07:00和20:00
my_token = input,"",tag=TokenOnline,desc=粘贴tokenOnline(736位)
my_appid = input,"",tag=AppId,desc=粘贴appId
my_mobile = input,"",tag=手机号,desc=联通手机号(可选)
mode = select,"all","sign","ltzf","ttlxj","ttxc","market","security","cloud","woread","aiting","wostore","regional",tag=运行模块,desc=all=全部
queryOnly = switch,false,tag=仅查询
enableNotify = switch,true,tag=结果通知
enableSign = switch,true,tag=首页签到
enableLtzf = switch,true,tag=联通祝福
enableTtlxj = switch,true,tag=天天领现金
enableTtxc = switch,true,tag=通通乡村
enableMarket = switch,true,tag=权益超市
enableSecurity = switch,true,tag=安全管家
enableCloud = switch,true,tag=联通云盘
enableWoread = switch,false,tag=联通阅读
enableAiting = switch,true,tag=联通爱听
enableWostore = switch,true,tag=沃云手机
enableRegional = switch,true,tag=区域专区
marketWater = switch,true,tag=浇水
marketTask = switch,true,tag=超市任务
marketMember = switch,true,tag=会员中心
marketDraw = switch,true,tag=超市抽奖
marketClaim = switch,true,tag=自动领奖
grabCoupon = switch,false,tag=抢话费券
grabAmount = input,"5",tag=话费券面额
ahFriday = switch,false,tag=安徽周五
ahAmount = input,"",tag=安徽红包面额
requestNode = input,"",tag=请求节点
cloudImageFid = input,"",tag=云盘人脸FID
cloudUploadName = input,"8648",tag=云盘文件名
ttxcGarbageWait = input,"28",tag=垃圾分类秒
ttxcGrowMax = input,"20",tag=最大充能
wostoreMaxDraw = input,"1",tag=沃云抽奖上限

[Script]
# 写入token（填好设置后点这里）
cron "0 0 1 1 2020" script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom_init.js,timeout=30,tag=⚡写入Token,argument=token={my_token}&appId={my_appid}&mobile={my_mobile}
# 定时任务
cron {cron_time} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🕐定时任务,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{enableNotify},{marketWater},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]
# 手动执行
generic script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=▶️手动执行,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{enableNotify},{marketWater},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]

