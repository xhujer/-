[Argument]
cron = input,"0 7,20 * * *",tag=定时执行,desc=每天07:00和20:00执行
capture = switch,true,tag=自动抓取账号,desc=退出并重新登录中国联通 App 后自动保存；多账号自动追加
mode = select,"all","sign","ltzf","ttlxj","ttxc","market","security","cloud","woread","aiting","wostore","regional",tag=执行模块,desc=all 为执行全部已开启模块
queryOnly = switch,false,tag=仅查询模式,desc=只查询资产和任务状态

# 功能开关
enableSign = switch,true,tag=首页签到,desc=签到、月签、任务、话费红包
enableLtzf = switch,true,tag=联通祝福,desc=任务及抽奖
enableTtlxj = switch,true,tag=天天领现金,desc=每日打卡和立减金
enableTtxc = switch,true,tag=通通乡村,desc=签到、游戏任务、农场充能
enableMarket = switch,true,tag=权益超市,desc=任务、会员中心、抽奖和记录
enableSecurity = switch,true,tag=安全管家,desc=签到、日常任务和积分领取
enableCloud = switch,true,tag=联通云盘,desc=乘风活动、会员体验和重复文件清理
enableWoread = switch,false,tag=联通阅读,desc=阅读、心跳和抽奖；耗时较长，默认关闭
enableAiting = switch,true,tag=联通爱听,desc=签到、积分任务和积分查询
enableWostore = switch,true,tag=沃云手机,desc=签到、任务、抽奖和积分
enableRegional = switch,true,tag=区域专区,desc=新疆、河南、云南、辽宁和安徽
provinceOverride = select,"","安徽","新疆","河南","云南","辽宁",tag=号码归属地,desc=默认自动识别；识别失败时手动选择
enableNotify = switch,true,tag=结果通知,desc=运行结束后发送一条汇总通知

# 子功能
marketTask = switch,true,tag=权益超市任务,desc=执行浏览和分享任务
marketMember = switch,true,tag=权益会员中心,desc=执行会员中心浏览积分任务
marketDraw = switch,true,tag=权益超市抽奖,desc=自动使用已有抽奖次数
marketClaim = switch,true,tag=权益自动领奖,desc=查询可领取记录
hometownEnable = switch,false,tag=云盘家乡打卡,desc=涉及 multipart 图片上传；当前 Loon 版暂不执行，保留配置位
grabCoupon = switch,false,tag=日常任务同时抢券,desc=高频操作，默认关闭；建议使用下方独立抢兑定时
grabAmount = input,"5",tag=话费券面额,desc=匹配包含指定面额的奖品
ahFriday = switch,false,tag=安徽超级星期五,desc=仅安徽号码、周五执行
ahAmount = input,"",tag=安徽红包面额,desc=例如 50；留空不执行
requestNode = input,"",tag=请求策略或节点,desc=留空按当前分流
cloudImageFid = input,"",tag=云盘人脸图片 FID,desc=乘风模板图片，可留空
cloudUploadName = input,"8648",tag=云盘上传文件名,desc=用于识别和清理活动文件
ttxcGarbageWait = input,"28",tag=垃圾分类等待秒数,desc=默认 28 秒
ttxcGrowMax = input,"20",tag=单地块最大充能,desc=默认 20 次
wostoreMaxDraw = input,"1",tag=沃云积分抽奖上限,desc=默认 1 次

[Script]
# 登录请求抓取 token_online 和 appId；账号保存为数组，重复登录同账号会更新而不会重复添加
http-request ^https:\/\/(?:m\.client\.10010\.com\/mobileService\/(?:onLine|login|v1\/login)\.htm|(?:loginxx|loginhl)\.10010\.com\/mobileService\/(?:onLine|login_vcode_member)\.htm) script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,requires-body=true,timeout=30,tag=🔵中国联通抓取账号,enable={capture}

# 日常任务
cron {cron} script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通自动任务,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{provinceOverride},{enableNotify},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{hometownEnable},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]

# 独立抢兑：脚本根据 tag 中“抢兑”自动进入 sign-only + grabCoupon 模式
cron 58 9,17 * * * script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=600,tag=🔴中国联通抢兑,argument=[{grabAmount},{requestNode}]

# 安徽超级星期五：周五 09:58 启动，等待 10:00 开抢；需填写安徽红包面额
cron 58 9 * * 5 script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=600,tag=🟠安徽超级星期五,argument=[{provinceOverride},{ahAmount},{requestNode}]

# Loon 脚本页可手动运行
generic script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/chinaUnicom.js,timeout=1800,tag=🔵中国联通手动执行,argument=[{mode},{queryOnly},{enableSign},{enableLtzf},{enableTtlxj},{enableTtxc},{enableMarket},{enableSecurity},{enableCloud},{enableWoread},{enableAiting},{enableWostore},{enableRegional},{provinceOverride},{enableNotify},{marketTask},{marketMember},{marketDraw},{marketClaim},{grabCoupon},{grabAmount},{ahFriday},{ahAmount},{requestNode},{cloudImageFid},{cloudUploadName},{hometownEnable},{ttxcGarbageWait},{ttxcGrowMax},{wostoreMaxDraw}]

