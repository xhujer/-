!name = 统一快乐星球茄皇（五期）
#!desc = 多账号自动完成任务、收取好友能量并使用能量
#!author = tianbian
#!date = 2026-07-27
#!icon = https://farmgames.ioutu.cn/favicon.ico
#!system = iOS,iPadOS
#!tag = 茄皇,快乐星球,任务

[Argument]
QH = input,"",tag=账号配置,desc=格式 wid#openId；多账号使用 & 分隔
cron = input,"25 10 * * *",tag=执行时间,desc=默认每天 10:25 执行
notify = switch,true,tag=运行通知,desc=任务结束后发送结果通知
debug = switch,false,tag=调试日志,desc=开启后输出请求和加密库加载日志

[Script]
cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/qh_qiehuang.js, timeout=300, tag=统一快乐星球茄皇（五期）, argument=[{QH},{notify},{debug}], enable=true
