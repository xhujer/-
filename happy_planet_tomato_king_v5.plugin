#!name=统一快乐星球茄皇
#!desc=支持多账号登录、签到、浏览任务、收获、播种及循环浇水
#!author=tianbian
#!date=2026-07-27
#!system=iOS,iPadOS
#!loon_version=3.2.1(734)
#!tag=统一茄皇,签到,任务

[Argument]

QH = input,"",tag=账号信息,desc=格式：wid#手机号；多账号用 & 分隔，也支持换行

cron = input,"25 10 * * *",tag=执行时间,desc=默认每天 10:25 执行

[Script]

cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/happy_planet_tomato_king_v5.jstimeout,=900,tag=统一茄皇,argument=[{QH}],enable=true
