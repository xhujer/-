#!name=影视飓风小程序签到
#!desc=自动获取影视飓风小程序 Cookie，并执行每日签到和积分查询
#!author=tianbian
#!date=2026-07-27
#!system=iOS,iPadOS
#!tag=影视飓风,签到

[Argument]

cron = input,"28 8 * * *",tag=签到时间,desc=默认每天 08:28 执行签到

cookieCapture = switch,true,tag=自动获取 Cookie,desc=打开影视飓风小程序并进入签到页面时自动保存登录凭据

[Script]

http-request ^https:\/\/h5\.youzan\.com\/wscump\/(?:checkin|integral)\/.+\.json script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/yingshijufeng.js?v=20260727-9-capture,timeout=10,tag=影视飓风获取Cookie,enable={cookieCapture}

http-response ^https:\/\/h5\.youzan\.com\/wscshop\/weapp\/authorize\.json script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/yingshijufeng.js?v=20260727-9-authorize,timeout=10,requires-body=true,tag=影视飓风更新Cookie,enable={cookieCapture}

cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/yingshijufeng.js?v=20260727-9-checkin,timeout=90,tag=影视飓风每日签到,enable=true

[MITM]

hostname = h5.youzan.com
