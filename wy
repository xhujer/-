#!name=网易邮箱大师去广告
#!desc=移除网易邮箱大师开屏广告、签到任务提醒与运营内容，精简顶部快捷入口和侧拉抽屉；关闭邮件聚合、消息中心及自定义图标引导的远程开关。
#!author=tianbian
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MailMaster.png
#!category=iKeLee
#!openUrl=https://apps.apple.com/app/id897003024
#!tag=去广告,页面精简
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2026-07-27 09:40:00

[Rewrite]

# URL 运营配置
^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do(?:\?.*)?$ reject-dict

# 顶部快捷入口、会员运营位、活动标签及侧边横幅
^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/v2\/conf\.do(?:\?.*)?$ response-body-json-jq 'del(.data.memberOperator, .data.functionOperatorInfoList, .data.activityTabInfoList, .data.masterOperatorList, .data.extList.mineSideBanner) | .data.newCommonFuncList |= map(select(.strategyName | IN("邮箱管理", "替身邮箱", "安全中心", "邮件追踪")))'

# 侧拉抽屉只保留邮件追踪和替身邮箱；关闭广告、任务中心、邮件聚合、消息中心及图标引导
^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do(?:\?.*)?$ response-body-json-jq '.data.config |= map(if .functionName == "Function-Drawer-Tools" and (.result.tools? | type == "array") then .result.tools |= map(select(.name | IN("邮件追踪", "替身邮箱"))) elif .functionName == "Function-Smart-Aggregation" then .result.enable = false | .result.count = 0 elif .functionName == "Function-messageCenter" then .result.enable = false elif .functionName == "Function-App-Icon-Guide" then .result.enable = false elif .functionName == "Function-Task-Center" then .result.enable = false elif .functionName == "Function-NPS-Config" then .result.enable = false | .result.scenes = [] elif .functionName == "Function-AD" then .result.adShakeEnable = false else . end) | del(.data.config[] | select(.functionName == "Function-AD"))'

# 签到、积分及任务中心
^https:\/\/dashi\.163\.com\/task-center-api\/fapi\/task\/(?:list|overview|detail)(?:\?.*)?$ reject-dict

# 运营活动
^https:\/\/appconf\.mail\.163\.com\/mailoperating\/mailmaster\/api\/operator\/get(?:\?.*)?$ reject-dict

# 广告接口
^https:\/\/appconf\.mail\.163\.com\/mmad\/master\/get\.do(?:\?.*)?$ reject-dict
^https:\/\/appconf\.mail\.163\.com\/mmad\/get\.do(?:\?.*)?$ reject-dict
^https:\/\/appconf\.mail\.163\.com\/mmad-rewarded\/fapi\/config(?:\?.*)?$ reject-dict

# 会员入口
^https:\/\/dashi\.163\.com\/fgw\/mail-member-center\/external\/member\/v2\/entry(?:\?.*)?$ reject-dict
^https:\/\/mail\.163\.com\/fgw\/mail-member-center\/external\/member\/v2\/entry(?:\?.*)?$ reject-dict

[MitM]
hostname=appconf.mail.163.com,dashi.163.com,mail.163.com
