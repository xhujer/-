[Argument]
cron = input,"30 8 * * *",tag=定时执行,desc=每天 08:30 自动签到，支持五段/六段 Cron

[Script]
request if ${url} ~= /^https?:\/\/note\.youdao\.com\/(yws|login)\// then script("https://raw.githubusercontent.com/xhujer/-/refs/heads/main/noteyoudao.js") with tag="🟡有道云笔记获取账号", timeout=15
cron ${cron} then script("https://raw.githubusercontent.com/xhujer/-/refs/heads/main/noteyoudao.js") with tag="🟡有道云笔记自动签到", timeout=600

[Mitm]
hostname = note.youdao.com