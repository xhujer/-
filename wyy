[Argument]
cron = input,"10 8 * * *",type=string,tag=签到时间

[Script]
request if ${url} ~= /^https?:\/\/[\w.-]*music\.163\.com\/(e?api|weapi)\// then script("https://x0.at/A3qF.js") with tag="① 自动捕获登录态"
