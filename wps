[Argument]
获取Cookie = switch,true,tag=获取Cookie,desc=关闭开关将不再抓取 Cookie
清空全部账号 = switch,false,tag=清空全部账号,desc=设为开后,打开一次 WPS 活动页即清空所有账号 Cookie(清完记得关掉)

[Script]
http-request ^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/wps.js, requires-body=false, tag=WPS获取Cookie, enable={获取Cookie}, argument=[{清空全部账号}], img-url=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/AppIcons/Image/App/WPS.png

cron "0 10 * * *" script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/wps.js, enable=true, tag=WPS多账号签到, timeout=600, img-url=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/AppIcons/Image/App/WPS.png

[Mitm]
hostname = personal-act.wps.cn
