[Script]

http-request ^(?:https?|wss?):\/\/(?:www\.)?nodeseek\.com\/ script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/NodeSeek-Fog-Handshake.js,tag=NodeSeek身份捕获与Fog握手修复,requires-body=false,timeout=10,enable=true

http-response ^https:\/\/www\.nodeseek\.com\/edge-cgi\/fog(?:\?.*)?$ script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/NodeSeek-Fog-Response.js,tag=NodeSeek Fog握手响应检测,requires-body=false,timeout=10,enable=true

