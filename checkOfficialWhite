#!name=官方白名单校验改写
#!desc=拦截 m.client.10010.com 的 checkOfficialWhitePhone 接口,清空/改写请求体(需配合 MITM 证书)
#!author=Minis
#!homepage=https://example.com
#!version=1.0.0
#!system=ios

[MITM]
; 仅对该域名启用 HTTPS 解密
hostname = %APPEND% m.client.10010.com
skip-server-cert-verify = true

[Script]
; http-request 捕获该接口请求, 交给远程脚本改写 body
http-request ^https?:\/\/m\.client\.10010\.com\/edopinterface\/officialWhite\/checkOfficialWhitePhone script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/officialWhite, requires-body = true, tag = 官方白名单请求改写, enabled = true

; ===== 使用说明 =====
; 1. 将本 .plugin 导入 Loon (配置 → 插件 → + )
; 2. 系统设置 - 通用 - 关于本机 - 证书信任设置, 开启 Loon 根证书
; 3. 确保 10010 App 走 Loon 代理 (MITM 才能解密)
; 4. 远程脚本地址: https://raw.githubusercontent.com/xhujer/-/refs/heads/main/officialWhite
; 5. 脚本行为(清空请求体)在 officialWhite 脚本顶部 OPTIONS 配置