[Rule]

# 社区网页
DOMAIN,cp.jegotrip.com.cn,REJECT

# 社区动态静态资源
DOMAIN,cdn.jegotrip.com.cn,REJECT

# 商品推广素材
DOMAIN,jegotrip3.jegotrip.com.cn,REJECT

# 动态推广图片
DOMAIN,video.jegotrip.com.cn,REJECT

# 日志
DOMAIN,proj-xtrace-3d408a16b0f9bb39e477e8c4c494514e-cn-hangzhou.log.aliyuncs.com,REJECT


[Rewrite]


# 第三方日志
^https?:\/\/analysis\.tratao\.com\/api\/log(?:\?.*)?$ url reject


# 无忧行事件日志
^https?:\/\/app\.jegotrip\.com\.cn\/eventtracking\/api\/business\/event\/api\/log\/upload(?:\?.*)?$ url reject


# 点击日志
^https?:\/\/app-product\.jegotrip\.com\.cn\/logstores\/clickevent_ios_v5\/shards\/lb(?:\?.*)?$ url reject



# ==========================
# 签到/任务/福利入口
# ==========================

^https?:\/\/app\.jegotrip\.com\.cn\/api\/service\/v1\/mission\/.* url reject



# ==========================
# 动态悬浮助手
# ==========================

^https?:\/\/app\.jegotrip\.com\.cn\/api\/assistant\/message\/recommend(?:\?.*)?$ url reject

^https?:\/\/app\.jegotrip\.com\.cn\/api\/assistant\/alertV2(?:\?.*)?$ url reject



# ==========================
# 社区动态图片
# ==========================

^https?:\/\/cdn\.jegotrip\.com\.cn\/socialcontact\/.* url reject

^https?:\/\/cdn\.jegotrip\.com\.cn\/material\/userAlbum\/.* url reject



[MITM]

hostname =
app.jegotrip.com.cn,
app-product.jegotrip.com.cn,
analysis.tratao.com