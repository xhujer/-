#!name=无忧行去广告（托管通知保留版）
#!desc=保留登录、用户、会员、手机号托管与通知；移除推荐、活动、商城、社区和埋点
#!icon=https://imgtolinkx.com/i/CO0eIFoS
#!bundleId=com.cmi.jegotrip
#!date=2026-07-28

[Rule]
DOMAIN,app-product.jegotrip.com.cn,REJECT
DOMAIN,cp.jegotrip.com.cn,REJECT
DOMAIN,jegotrip3.jegotrip.com.cn,REJECT
DOMAIN,video.jegotrip.com.cn,REJECT
DOMAIN,analysis.tratao.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
DOMAIN,loggw-exsdk.alipay.com,REJECT

[Rewrite]
# 埋点
^https?:\/\/app\.jegotrip\.com\.cn\/eventtracking\/.* url reject

# 保留：登录/用户/会员/通知/推送/设备注册/消息
# 拒绝：首页、推荐、目的地、活动、商城、社区等业务
^https?:\/\/app\.jegotrip\.com\.cn\/api\/(?!(?:(?:service\/)?(?:user|member|login|auth|oauth|passport|account|sms|captcha|verify|token|session|message|notice|notification|push|device|register|badge|receipt)|assistant|thirdauth)(?:\/|$)).* url reject
^https?:\/\/app3\.jegotrip\.com\.cn\/api\/(?!(?:(?:service\/)?(?:user|member|login|auth|oauth|passport|account|sms|captcha|verify|token|session|message|notice|notification|push|device|register|badge|receipt)|assistant|thirdauth)(?:\/|$)).* url reject

[MITM]
hostname = app.jegotrip.com.cn,app3.jegotrip.com.cn,push.it.10086.cn
