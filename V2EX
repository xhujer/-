!name = V2EX 每日签到1
#!desc = 每日签到并执行阅读
#!author = Ming
#!icon = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/V2ex.png
#!system = iOS
#!loon_version = 3.5.0
#!tag = Check-in
#!type = normal

[Argument]

cronInput = input,"0 8 * * *",tag=签到时间

cookieCapture = switch,false,tag=获取Cookie,desc=打开后访问 V2EX 任意页面即可抓取 Cookie

[Rewrite]

^https://www\.v2ex\.com/(mission|member).* url script-request-header V2EX.js

[Script]

http-request ^https://www\.v2ex\.com/(mission|member).*$ script-path=V2EX.js,requires-body=false,timeout=10,tag=获取Cookie,enable={cookieCapture}

cron {cronInput} script-path=V2EX.js,timeout=1800,tag=V2EX签到,enable=true

generic script-path=V2EX.js,timeout=1800,tag=手动签到,enable=true

[MitM]

hostname = %APPEND% www.v2ex.com