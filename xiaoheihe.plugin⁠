#!name=小黑盒签到与任务
#!desc=自动获取账号并执行签到、分享帖子、分享游戏详情、分享游戏评价、访问游戏榜单，最后读取服务器任务状态。任务加密数据由可配置编码服务生成，仅向其提交盒号和任务名，不提交 Cookie。
#!author=tianbian
#!date=2026-07-29
#!version=2.0.0
#!icon=https://api.xiaoheihe.cn/favicon.ico
#!system=iOS,iPadOS
#!tag=小黑盒,签到,任务

[Argument]

cron = input,"15 0 * * *",tag=签到时间,desc=默认每天凌晨 00:15 执行

cookieCapture = switch,true,tag=自动获取账号,desc=打开小黑盒并进入“我的”页面或刷新时自动保存账号凭据

dailyTasks = switch,true,tag=执行日常任务,desc=执行分享帖子、分享游戏详情、分享游戏评价和访问游戏榜单

taskService = input,"http://47.120.39.109:9900/hkey",tag=任务编码服务,desc=原脚本使用的任务数据编码接口；只发送盒号、请求类型和任务名，不发送 Cookie

scriptPath = input,"https://raw.githubusercontent.com/xhujer/-/refs/heads/main/xiaoheihe_sign.js",tag=脚本地址,desc=请先把脚本上传到此地址

[Script]

http-request ^https:\/\/api\.xiaoheihe\.cn\/.*[?&](?:heybox_id|user_id)= script-path={scriptPath},timeout=10,tag=小黑盒获取账号,enable={cookieCapture}

cron {cron} script-path={scriptPath},timeout=120,tag=小黑盒签到与任务,argument=[{dailyTasks},{taskService}],enable=true

[MITM]

hostname = api.xiaoheihe.cn
