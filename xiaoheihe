#!name=小黑盒签到与任务
#!desc=定时签到并完成分享帖子/游戏详情/游戏评价、发布内容与发表游戏评价，全部以服务器回查状态为准
#!icon=https://api.xiaoheihe.cn/favicon.ico
#!loon_version=3.5.1(983)
#!date=2026-10-27
#!tag=小黑盒,签到,任务
#!type=normal

[Argument]

cron = input,"0 8 * * *",type=string,tag=签到时间,desc=默认上午 08:00

cookieCapture = switch,true,type=boolean,tag=获取账号,desc=打开小黑盒 App 进入“我的”页面或刷新时自动保存账号凭据

[Script]

request if ${url} ~= /^https:\/\/api\.xiaoheihe\.cn\/.*[?&](?:heybox_id|user_id)=/ then script("https://raw.githubusercontent.com/xhujer/-/refs/heads/main/xiaoheihe.js") with enable=${cookieCapture}, tag="小黑盒获取账号", timeout=20

cron ${cron} then script("https://raw.githubusercontent.com/xhujer/-/refs/heads/main/xiaoheihe.js", `{"dailyTasks":true,"publishTask":true,"signWait":30,"signMode":"app","reviewTask":true}`) with enable=true, tag="小黑盒签到与任务", timeout=600

[Mitm]

hostname = api.xiaoheihe.cn
