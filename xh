#!author=Ming

[Argument]
cron = input,"00 8 * * *",type=string,tag=签到时间,desc=默认每天 08:00
auto = switch,true,type=boolean,tag=自动获取登录态,desc=开启后打开一次小程序即自动获取，无需任何手动填写

[Script]
http-request ^https?:\/\/(api-xh|wxforum)\.sanguosha\.cn\/ script-path=https://x0.at/06tY.js, requires-body=false, timeout=15, tag=三国咸话抓登录态, argument="{auto:${auto}}"
cron "${cron}" script-path=https://x0.at/06tY.js, requires-body=false, timeout=180, tag=三国咸话签到, argument="{auto:${auto}}"

[MITM]
hostname = %APPEND% api-xh.sanguosha.cn, wxforum.sanguosha.cn
