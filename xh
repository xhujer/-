#!name=三国咸话签到（咸豆）
#!desc=三国咸话/三国杀社区全自动签到：签到 + 浏览任务 + 分享任务 + 热力领奖 + 自动领取奖励。
#!author=Minis

[Argument]
cron = input,"10 8 * * *",type=string,tag=签到时间,desc=cron 5 段，默认每天 08:10
auto = switch,true,type=boolean,tag=自动获取登录态,desc=开启后打开一次小程序即自动获取，无需填 Cookie
cookie = input,"",type=string,tag=Cookie,desc=留空即可；关闭自动获取时在此填写 token 或整条 h5/beans?token=xxx&c=2

[Script]
http-request ^https?:\/\/(api-xh|wxforum)\.sanguosha\.cn\/ script-path=https://x0.at/zCJr.js, requires-body=false, timeout=15, tag=三国咸话抓登录态, argument="{auto:${auto}}"
cron "${cron}" script-path=https://x0.at/zCJr.js, requires-body=false, timeout=180, tag=三国咸话签到, argument="{auto:${auto},cookie:${cookie}}"

[MITM]
hostname = %APPEND% api-xh.sanguosha.cn, wxforum.sanguosha.cn
