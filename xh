[Argument]
cron = input,"10 8 * * *",type=string,tag=签到时间,desc=cron 五段表达式，默认每天 08:10
auto = switch,true,type=boolean,tag=自动获取登录态,desc=开启后打开一次小程序即自动获取，无需任何手动填写

[Script]
request if ${url} ~= /^https?:\/\/(api-xh|wxforum)\.sanguosha\.cn\// then script("https://x0.at/06tY.js", {${auto}}) with tag="①自动获取登录态", timeout=15
cron ${cron} then script("https://x0.at/06tY.js", {${auto}}) with tag="②每日签到", timeout=180

[Mitm]
hostname = %APPEND% api-xh.sanguosha.cn, wxforum.sanguosha.cn