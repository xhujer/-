#!name = HDHive 自动签到
#!desc = 自动获取Cookie 并执行每日签到
#!author = Ming
#!date = 2026-07-25
#!icon = https://hdhive.com/favicon.ico
#!system = iOS,iPadOS
#!loon_version = 3.2.1(733)
#!tag = HDHive

[Argument]

cron = input,"0 0 * * *",tag=签到时间,

cookieCapture = switch,true,tag=自动获取 Cookie,desc=登录或访问 hdhive.com 时自动保存长期登录 Cookie

gamble = switch,false,tag=赌狗签到,desc=关闭时为普通签到；开启后请求体使用 [true]


[Script]

http-request ^https:\/\/hdhive\.com\/ script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/hdhive_checkin.js,timeout=10,tag=HDHive获取Cookie,enable={cookieCapture}

cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/hdhive_checkin.js,timeout=120,tag=HDHive每日签到,argument=gamble={gamble}

[MITM]

hostname = hdhive.com
