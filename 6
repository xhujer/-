#!name = 中国联通呼叫转移助手
#!desc = 呼叫转移查询、开通、关闭与转入号码设置；多账号支持，复用联通App会话鉴权
#!author = Minis
#!version = 1.0.0
#!date = 2026-10-08
#!system = iOS,iPadOS
#!loon_version = 3.5.0(969)
#!tag = 中国联通,呼叫转移
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/a2/83/c1/a283c1df-f7f7-f4c1-6a03-bb0db7eff558/AppIcon-0-0-1x_U007epad-0-11-0-85-220.png/512x512bb.jpg

[Argument]
# ── 运行模式 ──
mode = select,"query","query","open","close","set",tag=运行模式,desc=query仅查询状态；open开通；close关闭；set设置转入号码
# ── 目标场景 ──
scene = select,"unconditional","unconditional","busy","noAnswer","notAvailable",tag=转移场景,desc=unconditional无条件；busy遇忙占线；noAnswer无人接听；notAvailable无法接通
# ── 转入号码（仅 mode=set 使用）──
targetNumber = input,"",tag=转入号码,desc=仅支持联通手机号，11位；查询/开关模式可留空
# ── 账号抓取 ──
capture = switch,false,tag=自动抓取会话,desc=开启后退出并重新登录中国联通App，自动保存会话Cookie
# ── 高级 ──
forceScene = switch,false,tag=强制提交,desc=忽略本地已开通/未开通检查，直接按所选方向提交
enableNotify = switch,true,tag=结果通知,desc=运行后推送一条汇总通知
requestNode = input,"",tag=请求策略或节点,desc=留空按当前分流

[Script]
# 抓取会话：拦截呼叫转移查询接口，保存完整 Cookie（在App内打开一次呼叫转移页面即触发）
http-request ^https:\/\/mxx\.client\.10010\.com\/servicetransactbusiness\/callForwardingNew\/queryCallOutState script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/c,requires-body=false,timeout=30,tag=🔵联通呼叫转移抓取会话,enable={capture},argument=[{capture},{enableNotify}]

# 手动执行：Loon 脚本页点运行，按 mode/scene 执行查询或办理
generic script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/c,timeout=120,tag=🔵联通呼叫转移手动执行,argument=[{mode},{scene},{targetNumber},{forceScene},{enableNotify},{requestNode}]

# 定时查询：每天 09:00 查询一次呼叫转移状态
cron 0 9 * * * script-path = https://raw.githubusercontent.com/xhujer/-/refs/heads/main/c,timeout=120,tag=🔵联通呼叫转移每日查询,argument=[query,unconditional,,{forceScene},{enableNotify},{requestNode}]

[Mitm]
hostname = mxx.client.10010.com,m.client.10010.com,imgxx.client.10010.com
