#!name=NodeSeek 自动签到
#!desc=自动抓取 Cookie，支持随机或固定签到，并显示签到奖励、排名和账户信息
#!author=ming
#!icon=https://cdn.nodeimage.com/i/jQkBni6VOwjCQ8zOaWzlhbDPAoHE3Svz.jpeg
#!homepage=https://www.nodeseek.com/
#!system=iOS,iPadOS
#!date=2026-07-25

[Argument]

RunTime = input,"0 0 * * *",tag=每日签到时间,desc=默认每天早上 06:00 执行签到

CaptureCookie = switch,true,tag=自动获取 Cookie,desc=开启后访问 NodeSeek 自动更新 Cookie 和 User-Agent

Random = switch,true,tag=随机签到,desc=开启为随机签到，关闭为固定签到

[Script]

cron {RunTime} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/NodeSeek.js,tag=NodeSeek签到,timeout=60,argument=[{Random}]

http-request ^https?:\/\/(?:www\.)?nodeseek\.com\/ script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/NodeSeek.js,tag=NodeSeek抓Cookie,timeout=10,requires-body=false,enable={CaptureCookie}

[MITM]

hostname = nodeseek.com, www.nodeseek.com