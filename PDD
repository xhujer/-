#!name=拼多多果园
#!desc=拼多多果园自动浇水/签到/任务领取/偷水
#!author=LO
#!version=2.0.0
#!date=2026-08-07
#!icon = https://static.yangkeduo.com/favicon.ico
#!system=ios
#!supported=Loon

[Argument]

cron = input,"0 8 * * *",tag=执行时间,desc=每天自动执行时间（cron 表达式，默认每天 08:00）

cookieCapture = switch,true,tag=自动获取 Cookie,desc=开启后，打开拼多多 App 果园页面时自动捕获登录身份（AccessToken/pdduid/api_uid）并保存，无需手动复制

water = input,20,tag=浇水次数,desc=每次运行最多浇水次数（默认 20）

steal = switch,true,tag=偷水,desc=是否执行偷水（好友/机器人）

[Script]

# 定时执行：浇水/签到/任务/偷水
cron {cron} script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/PDF.js, timeout=300, tag=拼多多果园-自动浇水, argument=water={water},steal={steal}

# 捕获 App 登录身份（拼多多 App 果园流量），由开关控制
http-request ^https?:\/\/api\.pinduoduo\.com\/.* script-path=https://raw.githubusercontent.com/xhujer/-/refs/heads/main/PDF.js, timeout=10, tag=拼多多果园-捕获App身份, enable={cookieCapture}

[MITM]

hostname = %APPEND% api.pinduoduo.com
